# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin)
ADMIN_PASSWORD=
# Any long random string; signs the admin login cookie.
ADMIN_SESSION_SECRET=

# Bunny Stream (bunny.net → Stream → your library → API)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Security → "Embed view token authentication" key (enable token auth there)
BUNNY_STREAM_TOKEN_KEY=

# Email (Resend). Added automatically by the Vercel ↔ Resend integration.
RESEND_API_KEY=
EMAIL_FROM=Nemo Kino <noreply@nemokino.com>
# Public site address used in emailed links and the QPay callback, e.g. https://www.nemokino.com
SITE_URL=

# Any long random string; protects user PINs. Changing it later invalidates every PIN.
PIN_SECRET=

# QPay merchant (website payments)
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=

# Any long random string; lets the scheduled job call /api/payments/sync.
CRON_SECRET=
