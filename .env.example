# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin)
ADMIN_PASSWORD=
# Any long random string; signs the admin login cookie.
ADMIN_SESSION_SECRET=

# Bunny Stream (bunny.net → Stream → your library → API)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Security → "Embed view token authentication" key (enable token auth there)
BUNNY_STREAM_TOKEN_KEY=

# Email (Resend). Added automatically by the Vercel ↔ Resend integration.
RESEND_API_KEY=
EMAIL_FROM=Nemo Kino <noreply@nemokino.com>
# Public site address used in emailed links, e.g. https://www.nemokino.com
SITE_URL=
